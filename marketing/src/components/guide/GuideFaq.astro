---
import { type FaqItem } from '@/data/guides/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{/* Rendered from the same array as the FAQPage JSON-LD. Answers stay in the DOM even when
    a <details> is closed, so nothing here is hidden from crawlers. */}
<div class="flex flex-col gap-3">
  {
    items.map((item) => (
      <details class="rounded-lg border border-gray-200 bg-white px-4 py-3">
        <summary class="cursor-pointer text-base font-semibold text-primary">
          {item.question}
        </summary>
        <p class="mt-2 text-base leading-relaxed text-gray-600">{item.answer}</p>
      </details>
    ))
  }
</div>
