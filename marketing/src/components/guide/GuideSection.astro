---
import { MarketingTitle } from '@/components/ui/MarketingTitle.tsx';

interface Props {
  /** Anchor target; must match the ToC entry and any JSON-LD fragment that points here. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;

// No @tailwindcss/typography in this package, and preflight strips list markers and
// paragraph margins — so style descendants here rather than per element, following the
// `[&_img]:…` precedent in Nav.astro.
const proseClass = [
  '[&_p]:mb-4 [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-gray-600',
  '[&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:text-base [&_ul]:leading-relaxed [&_ul]:text-gray-600',
  '[&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:text-base [&_ol]:leading-relaxed [&_ol]:text-gray-600',
  '[&_li]:mb-1',
  '[&_a]:text-primary [&_a]:underline-offset-4 hover:[&_a]:underline',
  '[&_strong]:font-semibold [&_strong]:text-gray-800',
].join(' ');
---

{/* tabindex="-1" makes this a reliable focus destination for a fragment link. */}
<section id={id} tabindex="-1" class={`scroll-mt-24 ${proseClass}`}>
  <MarketingTitle level={2} className="mb-3">{title}</MarketingTitle>
  <slot />
</section>
