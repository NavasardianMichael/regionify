---
import { MarketingButton } from '@/components/ui/MarketingButton/MarketingButton.tsx';
import { MarketingTitle } from '@/components/ui/MarketingTitle.tsx';
import { GUIDES } from '@/data/guides/registry';
import { guideIndexPath, guidePath } from '@/helpers/guides';

interface Props {
  countryName: string;
}

const { countryName } = Astro.props;
---

<section class="bg-gray-50 py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    {/* No "a"/"an": 36 of the 190 country names start with a vowel, which rendered
        "a Armenia map". Also carries the "<country> regional map" search phrase. */}
    <MarketingTitle level={2} className="mb-2 text-center">
      {countryName} regional map guides
    </MarketingTitle>
    <p class="mb-8 text-center text-base text-balance text-gray-500">
      Short, practical walkthroughs — importing your data, embedding the result, and animating it
      over time.
    </p>

    <ul class="grid gap-3 sm:grid-cols-2">
      {
        GUIDES.map((guide) => (
          <li>
            <MarketingButton type="card" href={guidePath(guide.slug)}>
              <span class="flex w-full flex-col gap-1 text-left">
                <span class="text-sm font-semibold text-gray-800">{guide.h1}</span>
                <span class="text-xs text-gray-400">{guide.navLabel}</span>
              </span>
            </MarketingButton>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-center">
      <MarketingButton type="link" href={guideIndexPath()}>All guides →</MarketingButton>
    </p>
  </div>
</section>
