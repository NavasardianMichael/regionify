---
import { MARKETING_LINKS_TO_APP } from '@/helpers/marketing';
import { MarketingButton } from '@/components/ui/MarketingButton/MarketingButton.tsx';
import { guideIndexPath } from '@/helpers/guides';

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-white py-2">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="flex flex-col items-center gap-3 text-center text-sm text-gray-500 md:flex-row md:justify-between md:text-left">
      <p>
        © {year}
        <MarketingButton type="link" href={MARKETING_LINKS_TO_APP.footer.logo}>
          Regionify
        </MarketingButton>
        — Create choropleth maps for any country or region.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6 py-4 md:justify-end">
        <MarketingButton type="link" muted href={MARKETING_LINKS_TO_APP.footer.home}>
          Home
        </MarketingButton>
        {/* The only marketing-internal link in the footer — it reaches every guide from all
            190 country pages. */}
        <MarketingButton type="link" muted href={guideIndexPath()}>
          Guides
        </MarketingButton>
        <MarketingButton type="link" muted href={MARKETING_LINKS_TO_APP.footer.pricing}>
          Pricing
        </MarketingButton>
        <MarketingButton type="link" muted href={MARKETING_LINKS_TO_APP.footer.contact}>
          Contact
        </MarketingButton>
      </div>
    </div>
    <div google-add-preferred-source-btn data-theme="light" data-lang="en"></div>
  </div>
</footer>
